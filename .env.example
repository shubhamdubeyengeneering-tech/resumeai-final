# Backend
GEMINI_API_KEY=
RESUMEAI_GEMINI_MODEL=gemini-3.8-flash
AUTH_SECRET_KEY=change-this-to-a-long-random-secret
RESUMEAI_DB_PATH=./resumeai.db

# Google OAuth (optional until configured in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
RESUMEAI_FRONTEND_URL=http://localhost:5173

# Gmail SMTP (optional; use a Gmail App Password, never your normal Gmail password)
RESUMEAI_SMTP_HOST=smtp.gmail.com
RESUMEAI_SMTP_PORT=465
RESUMEAI_SMTP_USER=
RESUMEAI_SMTP_PASSWORD=
RESUMEAI_SMTP_FROM=

# More global job coverage (optional)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# One daily digest worker per deployment process
RESUMEAI_NOTIFICATION_WORKER=true

# Frontend build-time API URL (create a separate frontend .env file)
VITE_API_URL=http://127.0.0.1:8000
